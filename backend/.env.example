# ============================================================================
# AUTHENTICATION SETTINGS (ADD THESE)
# ============================================================================

# JWT Secret Key (Change this in production! Use: openssl rand -hex 32)
# Example: 8f4b2a8c9e7d3f1a6b5c2e9d4a7b1c6f
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-key

# JWT Algorithm
ALGORITHM=HS256

# Access token expiration (in hours)
ACCESS_TOKEN_EXPIRE_HOURS=24

# Enable authentication
AUTH_ENABLED=true

# Admin usernames (comma-separated if multiple)
ADMIN_USERS=admin

# ============================================================================
# (Keep existing settings below)
# ============================================================================
# DATABASE
DATABASE_URL=sqlite:///./dsa_tracker.db

# SERVER
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# LLM APIs (keep existing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
