# API Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./dsa_tracker.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dsa_tracker
DB_ECHO=False

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Integration Configuration (legacy)
LLM_ENABLED=False
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ── AI Tutor (NEW) ─────────────────────────────────────────────────────────────
# Gemini — FREE, 1500 req/day, no credit card needed
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Anthropic — PAID, optional override for Claude models
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which model the tutor uses by default  (gemini-2.0-flash | gemini-1.5-flash | claude-opus-4-6 | claude-sonnet-4-6)
TUTOR_DEFAULT_MODEL=gemini-2.5-flash-lite

# Code Execution Configuration
CODE_EXECUTION_TIMEOUT=5
MAX_CODE_LENGTH=10000
SANDBOX_ENABLED=True

# Cache Configuration
CACHE_ENABLED=True
CACHE_TTL=3600

# File Upload Configuration
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=py,js,cpp,java
